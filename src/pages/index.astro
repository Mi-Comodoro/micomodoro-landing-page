---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/static/Navbar.astro';
import HeroSection from '../components/static/HeroSection.astro';
import FeaturesSection from '../components/static/FeaturesSection.astro';
import HowItWorksSection from '../components/static/HowItWorksSection.astro';
import FooterSection from '../components/static/FooterSection.astro';
import PricingSection from '../components/islands/PricingSection.vue';

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.micomodoro.com';
---

<BaseLayout>
  <Navbar />
  <main>
    <HeroSection />
    <FeaturesSection />
    <HowItWorksSection />
    <PricingSection appUrl={appUrl} client:load />
  </main>
  <FooterSection />
</BaseLayout>
