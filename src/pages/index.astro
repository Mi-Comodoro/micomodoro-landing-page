---
import LandingLayout from '../layouts/LandingLayout.astro';
import Sprite from '../components/v2/Sprite.astro';
import Nav from '../components/v2/Nav.astro';
import Hero from '../components/v2/Hero.astro';
import HowItWorks from '../components/v2/HowItWorks.astro';
import Compare from '../components/v2/Compare.astro';
import GoalDate from '../components/v2/GoalDate.astro';
import Includes from '../components/v2/Includes.astro';
import Ecosystem from '../components/v2/Ecosystem.astro';
import Plans from '../components/v2/Plans.astro';
import Privacy from '../components/v2/Privacy.astro';
import Faq from '../components/v2/Faq.astro';
import Access from '../components/v2/Access.astro';
import Footer from '../components/v2/Footer.astro';

const chips = ['Sin conectar tu banco', 'Transacciones y metas ilimitadas', 'Prueba Pro con todo incluido', 'Para mayores de 18 años'];
---

<LandingLayout>
  <Sprite />
  <Nav />
  <main>
    <Hero />
    <section class="chips" aria-label="Datos clave" style="padding-top:0">
      <div class="wrap">
        <ul>{chips.map((c) => <li>{c}</li>)}</ul>
      </div>
    </section>
    <HowItWorks />
    <Compare />
    <GoalDate />
    <Includes />
    <Ecosystem />
    <Plans />
    <Privacy />
    <Faq />
    <Access />
  </main>
  <Footer />
</LandingLayout>
