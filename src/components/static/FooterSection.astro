---
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-2 text-white font-bold text-lg">
      <svg width="24" height="24" viewBox="0 0 28 28" fill="none">
        <circle cx="14" cy="14" r="13" stroke="#0d9488" stroke-width="2"/>
        <path d="M14 6 L14 14 L20 14" stroke="#0d9488" stroke-width="2" stroke-linecap="round"/>
        <circle cx="14" cy="14" r="2" fill="#0d9488"/>
      </svg>
      Mi Comodoro
    </div>
    <p class="text-xs text-slate-500">
      © {year} Mi Comodoro. Todos los derechos reservados.
    </p>
    <div class="flex gap-6 text-xs">
      <a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
      <a href="/terminos" class="hover:text-white transition-colors">Términos</a>
      <a href="mailto:hola@micomodoro.com" class="hover:text-white transition-colors">Contacto</a>
    </div>
  </div>
</footer>
