---
const budgetLegend = [
  { color: '#0d9488', label: 'Necesidades', pct: '50%' },
  { color: '#8b5cf6', label: 'Gustos', pct: '30%' },
  { color: '#f59e0b', label: 'Ahorro', pct: '20%' },
];

const goals = [
  { name: 'Fondo de emergencia', progress: 68, current: '$2.040.000', goal: '$3.000.000', color: '#14b8a6' },
  { name: 'Vacaciones Dic', progress: 35, current: '$525.000', goal: '$1.500.000', color: '#f59e0b' },
  { name: 'Portátil nuevo', progress: 90, current: '$1.800.000', goal: '$2.000.000', color: '#a78bfa' },
];

const months = ['Dic', 'Ene', 'Feb', 'Mar', 'Abr', 'May'];
const points = [[0,45], [40,38], [80,42], [120,28], [160,22], [200,14]];
---

<section class="py-24 px-4 sm:px-6 bg-slate-950 overflow-hidden">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-16">
      <p class="text-primary-400 text-sm font-bold uppercase tracking-widest mb-4">El producto</p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">
        Todo en un solo lugar
      </h2>
      <p class="text-white/40 max-w-md mx-auto text-sm">
        Sin Excel. Sin cuadernos. Sin adivinar. Tu dinero, organizado y visible.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <div class="bg-slate-900 border border-white/10 rounded-2xl p-5 hover:border-primary-500/30 transition-colors">
        <div class="mb-4">
          <span class="bg-primary-900/50 text-primary-400 text-xs font-bold px-3 py-1 rounded-full">
            Presupuesto
          </span>
        </div>
        <h3 class="text-white font-bold text-lg mb-2">Sabe a dónde va cada peso</h3>
        <p class="text-white/40 text-sm mb-5 leading-relaxed">
          Estrategia 50/30/20 o la tuya. Registra ingresos una vez. El presupuesto se construye solo.
        </p>
        <div class="bg-slate-800/60 rounded-xl p-4 flex items-center gap-4">
          <svg width="90" height="90" viewBox="0 0 90 90" class="flex-shrink-0">
            <circle cx="45" cy="45" r="30" fill="none" stroke="#0d9488" stroke-width="16" stroke-dasharray="94.2 188.4" stroke-dashoffset="0" transform="rotate(-90 45 45)"/>
            <circle cx="45" cy="45" r="30" fill="none" stroke="#8b5cf6" stroke-width="16" stroke-dasharray="56.5 188.4" stroke-dashoffset="-94.2" transform="rotate(-90 45 45)"/>
            <circle cx="45" cy="45" r="30" fill="none" stroke="#f59e0b" stroke-width="16" stroke-dasharray="37.7 188.4" stroke-dashoffset="-150.7" transform="rotate(-90 45 45)"/>
            <text x="45" y="48" text-anchor="middle" fill="white" font-size="11" font-weight="800" font-family="Inter,sans-serif">50/30/20</text>
          </svg>
          <div class="flex flex-col gap-2 flex-1">
            {budgetLegend.map(d => (
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style={`background:${d.color}`}></span>
                <span class="text-white/60 text-xs">{d.label}</span>
                <span class="text-white text-xs font-bold ml-auto">{d.pct}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="bg-slate-900 border border-white/10 rounded-2xl p-5 hover:border-primary-500/30 transition-colors">
        <div class="mb-4">
          <span class="bg-amber-900/40 text-amber-400 text-xs font-bold px-3 py-1 rounded-full">
            Metas de Ahorro
          </span>
        </div>
        <h3 class="text-white font-bold text-lg mb-2">Tu ahorro crece con intereses</h3>
        <p class="text-white/40 text-sm mb-5 leading-relaxed">
          Define una meta, registra tus aportes y ve la proyección real con interés compuesto.
        </p>
        <div class="bg-slate-800/60 rounded-xl p-4 flex flex-col gap-3">
          {goals.map(m => (
            <div>
              <div class="flex justify-between items-center mb-1.5">
                <span class="text-white/70 text-[10px] font-medium">{m.name}</span>
                <span class="text-white/40 text-[10px]">{m.progress}%</span>
              </div>
              <div class="h-2 bg-slate-700 rounded-full overflow-hidden">
                <div class="h-full rounded-full transition-all" style={`width:${m.progress}%;background:${m.color}`}></div>
              </div>
              <div class="flex justify-between mt-1">
                <span class="text-[9px] font-bold" style={`color:${m.color}`}>{m.current}</span>
                <span class="text-white/30 text-[9px]">{m.goal}</span>
              </div>
            </div>
          ))}
          <p class="text-white/20 text-[9px] text-center pt-1 border-t border-white/5">
            💰 Proyección con interés compuesto activada
          </p>
        </div>
      </div>

      <div class="bg-slate-900 border border-white/10 rounded-2xl p-5 hover:border-primary-500/30 transition-colors md:col-span-2 lg:col-span-1">
        <div class="mb-4">
          <span class="bg-violet-900/40 text-violet-400 text-xs font-bold px-3 py-1 rounded-full">
            Analítica
          </span>
        </div>
        <h3 class="text-white font-bold text-lg mb-2">Entiende tus patrones de gasto</h3>
        <p class="text-white/40 text-sm mb-5 leading-relaxed">
          Flujo de caja, tendencias, ratio de ahorro y proyecciones. Todo calculado automáticamente.
        </p>
        <div class="bg-slate-800/60 rounded-xl p-4">
          <p class="text-white/30 text-[9px] uppercase tracking-wider mb-3">Tendencia de ahorro — 6 meses</p>
          <svg width="100%" height="60" viewBox="0 0 220 60" preserveAspectRatio="none">
            <line x1="0" y1="50" x2="220" y2="50" stroke="#1e293b" stroke-width="1"/>
            <line x1="0" y1="30" x2="220" y2="30" stroke="#1e293b" stroke-width="1"/>
            <path d="M0 45 L40 38 L80 42 L120 28 L160 22 L200 14 L220 14 L220 60 L0 60 Z" fill="url(#areaGradShowcase)" opacity="0.3"/>
            <path d="M0 45 L40 38 L80 42 L120 28 L160 22 L200 14" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            {points.map(([x,y]) => (
              <circle cx={x} cy={y} r="3" fill="#14b8a6" stroke="#0f172a" stroke-width="1.5"/>
            ))}
            <defs>
              <linearGradient id="areaGradShowcase" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#14b8a6"/>
                <stop offset="100%" stop-color="#14b8a6" stop-opacity="0"/>
              </linearGradient>
            </defs>
          </svg>
          <div class="flex justify-between mt-1">
            {months.map(m => (
              <span class="text-white/20 text-[9px]">{m}</span>
            ))}
          </div>
          <div class="flex items-center gap-2 mt-3 pt-2 border-t border-white/5">
            <span class="text-base">🔥</span>
            <div>
              <p class="text-white text-xs font-bold">12 días seguidos</p>
              <p class="text-white/30 text-[9px]">registrando transacciones</p>
            </div>
            <div class="ml-auto bg-primary-900/40 rounded-lg px-2 py-1">
              <p class="text-primary-400 text-xs font-bold">+20%</p>
              <p class="text-white/30 text-[8px]">score</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <div class="text-center mt-12">
      <p class="text-white/30 text-sm mb-4">
        Todo esto disponible desde el primer día, con tu prueba de 45 días.
      </p>
    </div>

  </div>
</section>
