---
import { TRIAL_DAYS } from '../../config/pricing';

const stats = [
  { value: `${TRIAL_DAYS} dias`, label: 'de prueba Pro gratis', icon: 'Trial' },
  { value: '∞', label: 'transacciones siempre', icon: 'Sin limite' },
  { value: '0', label: 'conexion bancaria', icon: 'Privado' },
  { value: '3 planes', label: 'uno para cada etapa', icon: 'Escala' },
];
---

<section class="bg-primary-950 border-y border-primary-700/40 py-10 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
    {stats.map(s => (
      <div class="rounded-2xl border border-primary-200/25 bg-white/[0.09] px-4 py-5 text-center shadow-lg shadow-primary-950/20">
        <p class="mb-3 inline-flex rounded-full bg-primary-200 px-3 py-1 text-[10px] font-extrabold uppercase tracking-widest text-primary-950">
          {s.icon}
        </p>
        <p class="text-white font-black text-3xl sm:text-4xl leading-none mb-2">
          {s.value}
        </p>
        <p class="text-slate-100 text-xs sm:text-sm leading-tight font-semibold">{s.label}</p>
      </div>
    ))}
  </div>
</section>
