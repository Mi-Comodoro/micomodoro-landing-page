---
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.micomodoro.com';
const ctaUrl  = `${appUrl}/auth?plan=free&ref=landing-cta-final`;
---

<section class="py-28 px-4 sm:px-6 bg-primary-950 relative overflow-hidden">

  <!-- Decoración -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-primary-600/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-2xl mx-auto text-center z-10">
    <h2 class="text-3xl sm:text-5xl font-extrabold text-white leading-tight mb-6">
      Tu yo del mes que viene<br/>
      <span class="text-primary-400">te lo va a agradecer.</span>
    </h2>
    <p class="text-white/50 text-lg mb-10 leading-relaxed">
      Cada peso que llevas hoy es una decisión más consciente mañana.<br/>
      Empieza ahora. Es gratis.
    </p>
    <a
      href={ctaUrl}
      class="inline-flex items-center gap-3 bg-primary-500 hover:bg-primary-400 text-white font-extrabold px-10 py-5 rounded-2xl transition-all text-lg shadow-2xl shadow-primary-900/60 hover:-translate-y-0.5 hover:shadow-primary-800/60"
    >
      Empezar mi registro gratis
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <path d="M2 9h14M10 3l6 6-6 6"/>
      </svg>
    </a>
    <p class="mt-5 text-xs text-white/25 font-medium tracking-widest uppercase">
      Sin tarjeta de crédito &nbsp;·&nbsp; Sin contrato &nbsp;·&nbsp; Sin excusas
    </p>
  </div>

</section>
