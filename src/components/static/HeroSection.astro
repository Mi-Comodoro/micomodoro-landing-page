---
import AppMockupHero from './AppMockupHero.astro';
import { CTA_URLS } from '../../config/urls';
---

<section class="min-h-screen bg-primary-950 flex flex-col items-center justify-center px-4 sm:px-6 pt-28 sm:pt-32 pb-20 relative overflow-hidden">

  <!-- Glow background decorativo -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary-600/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-72 h-72 bg-teal-500/5 rounded-full blur-2xl"></div>
  </div>

  <div class="relative max-w-4xl mx-auto text-center z-10">

    <!-- Badge -->
    <div class="inline-flex items-center gap-2 bg-primary-900/80 border border-primary-500/60 text-primary-100 text-xs font-semibold px-4 py-2 rounded-full mb-10 backdrop-blur-sm">
      <span class="w-1.5 h-1.5 bg-primary-400 rounded-full animate-pulse"></span>
      Beta abierta · Más de 60 personas ya llevan sus finanzas aquí
    </div>

    <!-- Headline principal -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6 tracking-tight">
      Ganas dinero. Pero a fin de mes,<br/>
      <span class="text-primary-400">¿sabes en qué se fue?</span>
    </h1>

    <!-- Subheadline -->
    <p class="text-lg sm:text-xl text-slate-100 max-w-2xl mx-auto mb-12 leading-relaxed">
      No eres malo con el dinero.<br class="hidden sm:block"/>
      Simplemente nadie te enseñó a llevarlo.
      <span class="text-white font-semibold"> Mi Comodoro sí.</span>
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-6">
      <a
        href={CTA_URLS.free}
        class="w-full sm:w-auto bg-primary-200 hover:bg-primary-100 text-primary-950 font-extrabold px-8 py-4 rounded-2xl transition-all text-base shadow-xl shadow-primary-950/50 hover:shadow-primary-800/50 hover:-translate-y-0.5"
      >
        Empezar gratis — sin tarjeta
      </a>
      <a
        href="#el-problema"
        class="w-full sm:w-auto text-slate-100 hover:text-white font-medium px-6 py-4 rounded-2xl border border-white/25 hover:border-white/40 transition-all text-sm"
      >
        Ver cómo funciona ↓
      </a>
    </div>

    <!-- Trust line -->
    <p class="text-xs text-slate-200 font-semibold tracking-wide uppercase">
      Sin tarjeta de crédito &nbsp;·&nbsp; Sin contrato &nbsp;·&nbsp; Sin excusas
    </p>

  </div>

  <!-- App screenshot preview (placeholder que Codex reemplaza con imagen real si existe) -->
  <div class="relative mt-20 max-w-5xl mx-auto w-full z-10">
    <AppMockupHero />
  </div>

</section>
