---
import MobileMenu from '../islands/MobileMenu.vue';
import { CTA_URLS } from '../../config/urls';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-primary-950/90 backdrop-blur-md border-b border-white/5">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between relative">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="15" stroke="#14b8a6" stroke-width="2"/>
        <path d="M16 7 L16 16 L22 16" stroke="#14b8a6" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="16" cy="16" r="2.5" fill="#14b8a6"/>
      </svg>
      <span class="font-extrabold text-white text-lg tracking-tight group-hover:text-primary-400 transition-colors">
        Mi Comodoro
      </span>
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-8">
      <a href="#el-problema"  class="text-sm text-white/60 hover:text-white transition-colors font-medium">El problema</a>
      <a href="#como-funciona" class="text-sm text-white/60 hover:text-white transition-colors font-medium">Cómo funciona</a>
      <a href="#planes"        class="text-sm text-white/60 hover:text-white transition-colors font-medium">Planes</a>
    </div>

    <!-- CTA Desktop -->
    <a
      href={CTA_URLS.free}
      class="hidden md:inline-flex items-center gap-2 bg-primary-500 hover:bg-primary-400 text-white text-sm font-bold px-5 py-2.5 rounded-xl transition-colors shadow-lg shadow-primary-900/40"
    >
      Empezar gratis
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <path d="M2 7h10M8 3l4 4-4 4"/>
      </svg>
    </a>

    <!-- Mobile menu island -->
    <MobileMenu client:visible />
  </nav>
</header>
