---
const navItems = [
  { label: 'Beneficios', href: '#beneficios' },
  { label: 'Como funciona', href: '#como-funciona' },
  { label: 'Precios', href: '#precios' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Mi Comodoro, inicio">
      <span class="brand-mark" aria-hidden="true">MC</span>
      <span>Mi Comodoro</span>
    </a>

    <nav class="nav" aria-label="Navegacion principal">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="button button-primary header-cta" href="#contacto">Solicitar acceso</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgb(223 232 225 / 80%);
    background: rgb(251 253 251 / 88%);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
  }

  .brand-mark {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 8px;
    background: var(--color-brand-dark);
    color: #fff;
    font-size: 0.82rem;
    letter-spacing: 0;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav a {
    border-radius: 8px;
    padding: 10px 12px;
    color: var(--color-muted);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .nav a:hover {
    background: var(--color-soft);
    color: var(--color-brand-dark);
  }

  @media (max-width: 820px) {
    .nav {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .header-inner {
      min-height: 68px;
    }

    .brand span:last-child {
      display: none;
    }

    .header-cta {
      min-height: 42px;
      padding-inline: 14px;
      font-size: 0.9rem;
    }
  }
</style>
